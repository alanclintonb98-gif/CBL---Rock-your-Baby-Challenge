#include <stdint.h>
#include <libpynq.h>
#include<pinmap.h>
#include<switchbox.h>
 
int main(void) {
  pynq_init();
    switches_init();
    
    
    switchbox_set_pin(IO_AR0, SWB_PWM0);
    pwm_init(PWM0, 1000); 

    while(1){
        int state = get_switch_state(0);
        
        if (state == 1){
            pwm_set_duty_cycle(PWM0, 500); 
        } else {
            pwm_set_duty_cycle(PWM0, 200); 
        }
        
  
        sleep_msec(50); 
    }
    
    pwm_destroy(PWM0);
    switches_destroy();
    pynq_destroy();
    return EXIT_SUCCESS;
}

